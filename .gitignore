# Dependencies and package-manager caches
node_modules/
.pnp
.pnp.*
.npm/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Generated framework output and caches
# Keep build/: it contains the Sites/Vite integration source code.
/.next/
/.vinext/
/dist/
/out/
.vite/
.cache/
*.tsbuildinfo
next-env.d.ts

# Test output
/coverage/
/.nyc_output/
/playwright-report/
/test-results/

# Logs
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Secrets; only the empty example belongs in the repository
.env*
!.env.example
.dev.vars*
*.pem
*.key
*.p12
*.pfx

# Local hosting, preview and agent state
# Keep .openai/hosting.json: it is the non-secret deployment configuration.
/.vercel/
/.wrangler/
/.sites-runtime/
/.agents/
/.codex/

# Generated exports, screenshots, deployment archives and extraction caches
# Keep public/data/: the sourced catalogue and original GPX files are required.
/outputs/
/work/

# Local editor and operating-system files
.vs/
.vscode/
.idea/
*.suo
*.swp
*.swo
*~
.DS_Store
._*
Thumbs.db
Desktop.ini
